# Instellingen van HomeBaseOS. Na een wijziging: sudo systemctl restart homebaseos

# Sleutel voor aanmeldingen (install.sh vult een willekeurige waarde in).
# Een account maak je bij de eerste keer in de browser. APP_PASSWORD is alleen nog voor installaties van vroeger:
# zolang er geen eigen account is, geldt dat wachtwoord.
APP_PASSWORD=
SESSION_SECRET=

PORT=8080

# Ollama, als je het als Docker-container draait (zie README). Leeg laten als je het niet gebruikt.
OLLAMA_URL=http://127.0.0.1:11434

# Waar appgegevens, VM-schijven, ISO's en gedeelde mappen komen, kies je bij Instellingen → Opslag.
# Een nieuwe pool krijgt de mappen appdata, media, backups, vms en isos; wat nog geen plek had, komt daar.
# Wil je het toch hier vastleggen (vroeger), zet dan VM_DIR, ISO_DIR, APPDATA_DIR of SHARES_DIR.

# Netwerk voor nieuwe VM's:
#   network=default  achter NAT van libvirt (werkt meteen, maar de VM is niet zichtbaar in je thuisnetwerk)
#   bridge=br0       rechtstreeks in je thuisnetwerk (nodig voor Home Assistant; maak eerst br0, zie README)
VM_NETWORK=network=default

# Appstore (catalogus van Unraid Community Apps).
#   STACKS_DIR   compose-bestanden per app (zelfde map als Dockge gebruikt)
#   APP_UID/GID  gebruiker voor apps, in plaats van 99:100 van Unraid (meestal je eigen gebruiker: id -u / id -g)
STACKS_DIR=/opt/stacks
APP_UID=1000
APP_GID=1000

# Software-update: HomeBaseOS zoekt nieuwe versies tussen de releases van deze GitHub-repository.
# Is de repository privé, maak dan op GitHub een fine-grained token met alleen leesrecht op "Contents" voor deze repo.
UPDATE_REPO=lennertvh1/homebaseos
UPDATE_TOKEN=
