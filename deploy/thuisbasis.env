# Instellingen van Thuisbasis. Na een wijziging: sudo systemctl restart thuisbasis

# Wachtwoord voor de webinterface (verplicht) en de sleutel voor aanmeldingen.
# install.sh vult beide in met een willekeurige waarde.
APP_PASSWORD=
SESSION_SECRET=

PORT=8080

# Ollama, als je het als Docker-container draait (zie README). Leeg laten als je het niet gebruikt.
OLLAMA_URL=http://127.0.0.1:11434

# Waar de schijven van nieuwe VM's komen, en waar je ISO's en schijfbestanden (zoals Home Assistant OS) zet.
VM_DIR=/tank/vms
ISO_DIR=/tank/isos

# Netwerk voor nieuwe VM's:
#   network=default  achter NAT van libvirt (werkt meteen, maar de VM is niet zichtbaar in je thuisnetwerk)
#   bridge=br0       rechtstreeks in je thuisnetwerk (nodig voor Home Assistant; maak eerst br0, zie README)
VM_NETWORK=network=default

# Appstore (catalogus van Unraid Community Apps).
#   APPDATA_DIR  gegevens van apps; /mnt/user/appdata uit de templates wordt dit
#   SHARES_DIR   waar de overige Unraid-shares (/mnt/user/media, ...) naartoe gaan
#   STACKS_DIR   compose-bestanden per app (zelfde map als Dockge gebruikt)
#   APP_UID/GID  gebruiker voor apps, in plaats van 99:100 van Unraid (meestal je eigen gebruiker: id -u / id -g)
APPDATA_DIR=/snel/appdata
SHARES_DIR=/tank
STACKS_DIR=/opt/stacks
APP_UID=1000
APP_GID=1000
