# Settings of MajaOS. After a change: sudo systemctl restart majaos

# Key for sign-ins (install.sh fills in a random value).
# You create an account in the browser the first time. APP_PASSWORD is only for older installs:
# as long as there is no account of your own, that password applies.
APP_PASSWORD=
SESSION_SECRET=

# Web interface. Leave this out for port 80. Settings → General can change it afterwards.
# PORT=80

# Ollama, if you run it as a Docker container (see docs/guide.md). Leave empty if you don't use it.
OLLAMA_URL=http://127.0.0.1:11434

# Where app data, VM disks, ISOs and shared folders go is chosen in Settings → Storage.
# A new pool gets the folders appdata, media, backups, vms and isos; whatever had no place yet goes there.
# Want to pin it here anyway (older installs)? Then set VM_DIR, ISO_DIR, APPDATA_DIR or SHARES_DIR.

# Network for new VMs:
#   network=default  behind libvirt's NAT (works right away, but the VM isn't visible in your home network)
#   bridge=br0       directly in your home network (needed for Home Assistant; create br0 first, see docs/guide.md)
VM_NETWORK=network=default

# App store (catalogue of Unraid Community Apps).
#   STACKS_DIR   compose files per app (the same folder Dockge uses)
#   APP_UID/GID  user for apps, instead of Unraid's 99:100 (usually your own user: id -u / id -g)
STACKS_DIR=/opt/stacks
APP_UID=1000
APP_GID=1000

# Software update: MajaOS looks for new versions among the releases of this GitHub repository.
# If the repository is private, create a fine-grained token on GitHub with only read access to "Contents" for this repo.
UPDATE_REPO=lennertvh1/MajaOS
UPDATE_TOKEN=
