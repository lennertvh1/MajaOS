[Unit]
Description=HomeBaseOS (management of your home server)
After=network-online.target libvirtd.service docker.service zfs.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/homebaseos/homebaseos.env
ExecStart=/usr/bin/node /opt/homebaseos/server.js
Restart=on-failure
RestartSec=5
# /var/lib/homebaseos: own settings (e.g. the start delay of VMs)
StateDirectory=homebaseos
# /run/homebaseos: marker "VMs already started automatically". Stays until the server reboots,
# so a restart of HomeBaseOS itself doesn't start your VMs again.
RuntimeDirectory=homebaseos
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
