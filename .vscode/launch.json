{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Demo (sample data)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "args": [
        "--demo"
      ],
      "runtimeArgs": [
        "--watch"
      ],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "port (\\d+)",
        "uriFormat": "http://localhost:%s"
      }
    },
    {
      "name": "On the server (.env)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "runtimeArgs": [
        "--watch"
      ],
      "console": "integratedTerminal",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "port (\\d+)",
        "uriFormat": "http://localhost:%s"
      }
    },
    {
      "name": "Tests",
      "type": "node",
      "request": "launch",
      "runtimeArgs": [
        "--test"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
