# For development on the server itself: copy to .env (npm run dev).
# On your Mac use npm run demo: it doesn't need ZFS, libvirt or Docker.
# Without APP_PASSWORD you create an account in the browser the first time.
# APP_PASSWORD=choose-a-password
PORT=8080
OLLAMA_URL=http://127.0.0.1:11434
VM_NETWORK=network=default
STACKS_DIR=/opt/stacks
# You choose folders in Settings → Storage. You can still pin them with VM_DIR, ISO_DIR, APPDATA_DIR and SHARES_DIR.
# DATA_DIR=/var/lib/majaos
