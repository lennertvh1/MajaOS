# Voor ontwikkelen op de server zelf: kopieer naar .env (npm run dev).
# Op je Mac gebruik je npm run demo: daar zijn ZFS, libvirt en Docker niet nodig.
# Zonder APP_PASSWORD maak je bij de eerste keer in de browser een account aan.
# APP_PASSWORD=kies-een-wachtwoord
PORT=8080
OLLAMA_URL=http://127.0.0.1:11434
VM_NETWORK=network=default
STACKS_DIR=/opt/stacks
# Mappen kies je bij Instellingen → Opslag. Vastleggen kan nog met VM_DIR, ISO_DIR, APPDATA_DIR en SHARES_DIR.
# DATA_DIR=/var/lib/homebaseos
