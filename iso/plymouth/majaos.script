Window.SetBackgroundTopColor(0.063, 0.102, 0.200);
Window.SetBackgroundBottomColor(0.063, 0.102, 0.200);

# 256 px is too big on a small VM screen.
logo.image = Image("logo.png").Scale(128, 128);
logo.sprite = Sprite(logo.image);

# Keeps moving until Cog replaces this screen. It never quite finishes on its own.
meter.image = Image("bar.png");
meter.track = Sprite(meter.image.Scale(220, 6));
meter.track.SetOpacity(0.28);
meter.fill = Sprite(meter.image.Scale(8, 6));
meter.level = 0;

fun refresh () {
  if (Window.GetWidth() < 16) return;
  logo.sprite.SetX(Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
  logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 16);
  meter.level = meter.level + (0.9 - meter.level) * 0.02;
  if (meter.level < 0.04) meter.level = 0.04;
  fill_w = Math.Int(220 * meter.level);
  if (fill_w < 8) fill_w = 8;
  meter.fill.SetImage(meter.image.Scale(fill_w, 6));
  x = Window.GetWidth() / 2 - 110;
  y = Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 8;
  meter.track.SetX(x);
  meter.track.SetY(y);
  meter.fill.SetX(x);
  meter.fill.SetY(y);
}

Plymouth.SetRefreshFunction(refresh);
