[Unit]
Description=Installing HomeBaseOS (first boot after the ISO)
After=network-online.target
Wants=network-online.target
# Only while the installation files are still there: they disappear after a successful installation.
ConditionPathExists=/opt/homebaseos-setup/install.sh

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/homebaseos-setup/iso/firstboot.sh
TimeoutStartSec=0
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
